# Copy to .env next to docker-compose.yml and fill in. Never commit .env.

# Domain whose A record points at this server, without https://
DOMAIN=crm.example.com

# Image tag: main follows the latest merge, or pin a commit SHA
TAG=main

# Generate each with: openssl rand -hex 32
PG_DATABASE_PASSWORD=
ENCRYPTION_KEY=

# Photos and files live on this server by default (backed up by backup.sh).
# To use DigitalOcean Spaces instead, set STORAGE_TYPE=s3 and fill these in.
STORAGE_TYPE=local
# STORAGE_S3_REGION=fra1
# STORAGE_S3_NAME=
# STORAGE_S3_ENDPOINT=https://fra1.digitaloceanspaces.com
# STORAGE_S3_ACCESS_KEY_ID=
# STORAGE_S3_SECRET_ACCESS_KEY=

# Optional off-site copy of the nightly backups (any S3-compatible bucket, e.g. Spaces)
# BACKUP_S3_BUCKET=
# BACKUP_S3_ENDPOINT=https://fra1.digitaloceanspaces.com
# BACKUP_S3_ACCESS_KEY_ID=
# BACKUP_S3_SECRET_ACCESS_KEY=
