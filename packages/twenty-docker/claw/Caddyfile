{$DOMAIN} {
	encode zstd gzip
	reverse_proxy server:3000
}

# Until SITE_DOMAIN is set the site answers only on localhost, so the CRM keeps working.
{$SITE_DOMAIN:localhost} {
	encode zstd gzip

	# The site's form talks to the CRM's public app routes on the same origin, so no CORS.
	handle_path /api/* {
		rewrite * /s{uri}
		reverse_proxy server:3000 {
			header_up Host {$DOMAIN}
		}
	}

	handle {
		root * /srv/site
		@pages not path /assets/*
		header @pages Cache-Control "no-cache"
		header /assets/* Cache-Control "public, max-age=86400"
		file_server
	}
}

www.{$SITE_DOMAIN:localhost} {
	redir https://{$SITE_DOMAIN:localhost}{uri} permanent
}
